{
  "name": "ts-planner",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "node scripts/check-cloud-config.mjs && vite build --configLoader native && node scripts/offline.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --configLoader native",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop:electron": "electron .",
    "package:electron": "npm run build && node scripts/package-windows.mjs",
    "test:locale": "node scripts/check-localization.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "@vitejs/plugin-react": "5.0.4",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.43.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.63.0",
    "electron": "^42.11.3",
    "sharp": "^0.35.4"
  },
  "main": "desktop/main.cjs"
}
